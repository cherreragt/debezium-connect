						"exec": [
							"// Lista de tablas con su PK\r",
							"const tablas = [\r",
							"  { nombre: \"CATEGORIA\", pk: \"ID\" },\r",
							"  { nombre: \"AUTOR\", pk: \"ID\" },\r",
							"  { nombre: \"LIBRO\", pk: \"ID\" },\r",
							"  { nombre: \"USUARIO\", pk: \"ID\" },\r",
							"  { nombre: \"PRESTAMO\", pk: \"ID\" }\r",
							"];\r",
							"\r",
							"// Función para esperar un tiempo (en ms)\r",
							"function delay(ms) {\r",
							"    return new Promise(resolve => setTimeout(resolve, ms));\r",
							"}\r",
							"\r",
							"// Función asincrónica para crear los conectores uno a uno con pausa\r",
							"(async () => {\r",
							"  for (const tabla of tablas) {\r",
							"    const uuid = crypto.randomUUID();\r",
							"    const body = {\r",
							"      \"name\": `jdbc-mysql-sink-${tabla.nombre.toLowerCase()}-${uuid}`,\r",
							"      \"config\": {\r",
							"        \"connector.class\": \"io.confluent.connect.jdbc.JdbcSinkConnector\",\r",
							"        \"key.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\r",
							"        \"key.converter.schema.registry.url\": \"http://schema-registry:8081\",\r",
							"        \"database.hostname\": \"172.25.32.1\",\r",
							"        \"tasks.max\": \"1\",\r",
							"        \"database.server.name\": \"test\",\r",
							"        \"database.history.kafka.topic\": \"history\",\r",
							"        \"connection.url\": \"jdbc:mysql://172.25.32.1:3306/DEBEZIUM\",\r",
							"        \"database.port\": \"3306\",\r",
							"        \"database.user\": \"root\",\r",
							"        \"database.password\": \"root\",\r",
							"        \"connection.user\": \"root\",\r",
							"        \"connection.username\": \"root\",\r",
							"        \"connection.password\": \"root\",\r",
							"        \"insert.mode\": \"upsert\",\r",
							"        \"delete.enabled\": \"true\", \r",
							"        \"auto.create\": \"false\",\r",
							"        \"primary.key.mode\": \"record_key\",\r",
							"        \"primary.key.fields\": tabla.pk,\r",
							"        \"auto.evolve\": \"true\",\r",
							"        \"schema.evolution\": \"basic\",\r",
							"        \"database.time_zone\": \"UTC\",\r",
							"        \"topics\": `test.DEBEZIUM.${tabla.nombre}`,\r",
							"        \"schema.history.internal.kafka.bootstrap.servers\": \"kafka:9092\",\r",
							"        \"transforms\": \"unwrap\",\r",
							"        \"transforms.unwrap.type\": \"io.debezium.transforms.ExtractNewRecordState\",\r",
							"        \"transforms.unwrap.drop.tombstones\": \"false\",//true\r",
							"        \"transforms.unwrap.delete.handling.mode\": \"drop\",//rewrite\r",
							"        \"transforms.unwrap.add.fields\": \"op,table,source.ts_ms\",\r",
							"        \"table.name.format\": `${tabla.nombre.toLowerCase()}`,\r",
							"        \"pk.mode\": \"record_key\",\r",
							"        \"pk.fields\": tabla.pk\r",
							"      }\r",
							"    };\r",
							"\r",
							"    console.log(`⏳ Creando conector para ${tabla.nombre}...`);\r",
							"\r",
							"    // Enviar el request\r",
							"    pm.sendRequest({\r",
							"      url: \"http://localhost:8083/connectors\",\r",
							"      method: \"POST\",\r",
							"      header: { \"Content-Type\": \"application/json\" },\r",
							"      body: {\r",
							"        mode: \"raw\",\r",
							"        raw: JSON.stringify(body)\r",
							"      }\r",
							"    }, (err, res) => {\r",
							"      if (err) {\r",
							"        console.log(`❌ Error creando conector para ${tabla.nombre}:`, err);\r",
							"      } else {\r",
							"        console.log(`✅ Conector creado para ${tabla.nombre}: Código ${res.code}`);\r",
							"      }\r",
							"    });\r",
							"\r",
							"    // Esperar 10 segundos antes del siguiente request\r",
							"    await delay(10000);\r",
							"  }\r",
							"})();\r",
							""
						],
						"type": "text/javascript",
